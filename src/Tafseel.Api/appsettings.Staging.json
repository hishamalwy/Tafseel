{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/tafseel-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  },
  "Security": {
    "EnforceHttps": false,
    "AllowInsecureRefreshCookie": true
  },
  "Payments": {
    "Provider": "Mock",
    "Mock": {
      "Enabled": true,
      "SimulatorEnabled": true,
      "DefaultReturnPath": "/student/overview"
    }
  },
  "LiveSessions": {
    "Provider": "Mock"
  },
  "FileStorage": {
    "Provider": "Local"
  },
  "Email": {
    "From": "Tafseel <no-replay@hishamalwy.site>",
    "PasswordResetUrl": "https://tafseel.runasp.net/auth",
    "ConfirmationUrl": "https://tafseel.runasp.net/auth",
    "AppBaseUrl": "https://tafseel.runasp.net"
  },
  "Cors": {
    "AllowedOrigins": [
      "https://tafseel.runasp.net"
    ]
  },
  "TeacherShowcases": {
    "Enabled": false
  },
  "AllowedHosts": "tafseel.runasp.net"
}
