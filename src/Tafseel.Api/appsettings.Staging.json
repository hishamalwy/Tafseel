{
  "ConnectionStrings": {
    "Tafseel": "Server=localhost;Database=Tafseel_Staging;Trusted_Connection=True;MultipleActiveResultSets=false;TrustServerCertificate=True"
  },
  "Database": {
    "Name": "Tafseel_Staging"
  },
  "Security": {
    "EnforceHttps": false,
    "AllowInsecureRefreshCookie": true
  },
  "Payments": {
    "Provider": "Paymob"
  },
  "LiveSessions": {
    "Provider": "Mock"
  },
  "FileStorage": {
    "Provider": "Local",
    "RootPath": "App_Data/staging"
  },
  "DataProtection": {
    "KeysPath": "App_Data/staging/keys"
  },
  "MalwareScanning": {
    "Mode": "Development"
  },
  "Email": {
    "From": "Tafseel Staging <staging@tafseel.local>",
    "PasswordResetUrl": "http://localhost:5200/auth",
    "ConfirmationUrl": "http://localhost:5200/auth",
    "AppBaseUrl": "http://localhost:5200",
    "Delivery": "Outbox",
    "SuppressedRecipients": [ "admin@gmail.com", "student@gmail.com", "teacher@gmail.com", "quality@gmail.com", "finance@gmail.com" ]
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5200" ]
  },
  "TeacherShowcases": {
    "Enabled": false
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
