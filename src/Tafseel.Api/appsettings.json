{
  "ConnectionStrings": {
    "Tafseel": "Server=(localdb)\\mssqllocaldb;Database=Tafseel;Trusted_Connection=True;MultipleActiveResultSets=false;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Tafseel.Api",
    "Audience": "Tafseel.Web",
    "SigningKey": "REPLACE_WITH_SECRET_MANAGER_VALUE",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Privacy": {
    "ReadNotificationDays": 180,
    "AuthenticationRecordDays": 30,
    "MarketplaceAnalyticsDays": 365,
    "BatchSize": 1000
  },
  "Cors": {
    "AllowedOrigins": [
      "https://localhost:7272"
    ]
  },
  "Resend": {
    "ApiToken": ""
  },
  "Fees": {
    "StudentFeePercent": 8,
    "TeacherCommissionPercent": 15
  },
  "LiveSessions": {
    "Provider": "Mock",
    "EmergencyPremiumPercent": 50,
    "CancellationWindowHours": 24,
    "JoinWindowMinutes": 15,
    "NoShowGraceMinutes": 15,
    "SettlementReviewHours": 24
  },
  "OpenMarketplace": {
    "OfferReservationMinutes": 120
  },
  "Withdrawals": {
    "MinimumAmount": 50,
    "Currency": "SAR",
    "ExpectedSettlementBusinessDays": 3
  },
  "Payments": {
    "Provider": "Mock",
    "WebhookSecret": "",
    "AutoReleaseEnabled": true,
    "AutoReleaseAfterHours": 72,
    "Mock": {
      "Enabled": true,
      "SimulatorEnabled": false,
      "DefaultReturnPath": "/student/overview"
    }
  },
  "Disputes": {
    "WindowDays": 7,
    "InitialResponseHours": 24,
    "ResolutionHours": 72
  },
  "Orders": {
    "NonDeliveryGraceHours": 24
  },
  "Email": {
    "From": "Tafseel <onboarding@resend.dev>",
    "PasswordResetUrl": "https://localhost:7272/auth",
    "ConfirmationUrl": "https://localhost:7272/auth",
    "AppBaseUrl": "https://localhost:7272"
  },
  "DataProtection": {
    "KeysPath": "App_Data/keys"
  },
  "FileStorage": {
    "Provider": "Local",
    "RootPath": "App_Data",
    "MaxDemoBytes": 262144000,
    "AzureBlob": {
      "ConnectionString": "",
      "ContainerName": "tafseel-private"
    }
  },
  "Ai": {
    "Enabled": false,
    "Provider": "Groq",
    "Endpoint": "https://api.groq.com/openai/v1",
    "Model": "openai/gpt-oss-120b",
    "TimeoutSeconds": 20,
    "MaxInputCharacters": 4000,
    "MaxOutputTokens": 800
  },
    "TeacherShowcases": {
      "Enabled": false,
      "DurableObjectStorage": false,
      "MalwareScanning": false,
      "ReliableMediaProbing": false,
      "RetentionPolicy": false,
      "CopyrightReportingPolicy": false,
      "ModerationOperations": false,
      "SecureMediaDelivery": false,
    "MaxPublicPerTeacher": 6,
    "MaxPublicPerSubject": 3,
    "MaxVersionsPerShowcase": 20,
    "MaxFilesPerUpload": 6
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "localhost;127.0.0.1"
}
