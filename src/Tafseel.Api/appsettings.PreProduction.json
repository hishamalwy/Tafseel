{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "App_Data/logs/tafseel-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true
        }
      }
    ]
  },
  "Security": {
    "EnforceHttps": true,
    "AllowInsecureRefreshCookie": false
  },
  "Payments": {
    "Provider": "Mock",
    "AutoReleaseEnabled": true,
    "Mock": {
      "Enabled": true,
      "SimulatorEnabled": true,
      "DefaultReturnPath": "/student/overview"
    }
  },
  "LiveSessions": {
    "Provider": "JaaS"
  },
  "JaaS": {
    "AppId": "vpaas-magic-cookie-3cf93a7e492444b1b82c6c38b06ad01c",
    "KeyId": "vpaas-magic-cookie-3cf93a7e492444b1b82c6c38b06ad01c/a97301",
    "PrivateKeyPath": "App_Data/jaas"
  },
  "FileStorage": {
    "Provider": "Local"
  },
  "MalwareScanning": {
    "Mode": "Development"
  },
  "Email": {
    "From": "Tafseel <no-replay@hishamalwy.site>",
    "PasswordResetUrl": "https://tafseel.runasp.net/auth",
    "ConfirmationUrl": "https://tafseel.runasp.net/auth",
    "AppBaseUrl": "https://tafseel.runasp.net",
    "Delivery": "Resend",
    "SuppressedRecipients": [ "admin@gmail.com", "student@gmail.com", "teacher@gmail.com", "quality@gmail.com", "finance@gmail.com" ]
  },
  "Cors": {
    "AllowedOrigins": [ "https://tafseel.runasp.net" ]
  },
  "TeacherShowcases": {
    "Enabled": false
  },
  "AllowedHosts": "tafseel.runasp.net"
}
