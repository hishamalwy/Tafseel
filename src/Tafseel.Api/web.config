<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <security>
        <requestFiltering removeServerHeader="true">
          <requestLimits maxAllowedContentLength="62914560" />
        </requestFiltering>
      </security>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
      <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />
      <aspNetCore processPath="dotnet"
                  arguments=".\Tafseel.Api.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\App_Data\logs\stdout"
                  startupTimeLimit="120"
                  requestTimeout="00:05:00"
                  hostingModel="inprocess">
        <!-- ASPNETCORE_ENVIRONMENT comes from the publish profile (EnvironmentName) or the host's settings.
             Without one the app starts as Production, which refuses mock providers: a safe default. -->
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>
