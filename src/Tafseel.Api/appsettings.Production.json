{
  "Security": {
    "EnforceHttps": true,
    "AllowInsecureRefreshCookie": false
  },
  "Jwt": {
    "SigningKey": "REPLACE_WITH_SECRET_MANAGER_VALUE"
  },
  "Payments": {
    "Provider": "Paymob"
  },
  "LiveSessions": {
    "Provider": "REPLACE_WITH_REGISTERED_REAL_PROVIDER"
  },
  "MalwareScanning": {
    "Mode": "ClamAv",
    "ClamAv": {
      "Host": "REPLACE_WITH_CLAMD_HOST",
      "Port": 3310
    }
  },
  "FileStorage": {
    "Provider": "AzureBlob",
    "AzureBlob": {
      "ConnectionString": "REPLACE_WITH_AZURE_BLOB_CONNECTION_STRING",
      "ContainerName": "tafseel-private"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "Resend": {
    "ApiToken": ""
  },
  "Email": {
    "From": "Tafseel <noreply@verified.example>",
    "PasswordResetUrl": "https://app.example.invalid/auth",
    "ConfirmationUrl": "https://app.example.invalid/auth"
  },
  "Cors": {
    "AllowedOrigins": [ "https://app.example.invalid" ]
  }
,
  "Paymob": { "Mode": "Live", "IntegrationId": 0 }
}
