# Local design sandbox. Not built or served; it reads css/tafseel.css and assets/.
design-lab/

# Local secrets and machine-specific configuration
.env
.env.*
!.env.example
src/Tafseel.Api/appsettings.Local.json
**/appsettings.*.Host.json
deploy/iis-runasp/web.config
tests/browser/.auth/

# Runtime state and private/local uploads. The API project ships an empty
# App_Data/logs directory, so only its placeholder is tracked.
**/App_Data/*
!src/Tafseel.Api/App_Data/logs/
src/Tafseel.Api/App_Data/logs/*
!src/Tafseel.Api/App_Data/logs/.keep
uploads/

# Logs and local process captures
*.log
.tmp*/
/tmp/

# OS and generated thumbnails
.DS_Store
Thumbs.db
Desktop.ini
.thumbnail

# Package and language caches
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Playwright / browser automation outputs
playwright-report/
blob-report/
test-results/
**/playwright/.cache/

# One-off local patch, debug and audit scripts (keep out of git)
_audit_*
_css_diff.json
_html_usage.json
/audit_extract.ps1
/i18n_usage.csv
/locales_en_keys.txt
/missing_i18n_keys.txt
/landing-fold-check.png
/self-test-results.json
/scripts/tmp-*.mjs
tests/browser/_*.mjs

# Angular client (frontend-angular)
frontend-angular/dist/
frontend-angular/.angular/
frontend-angular/out-tsc/
