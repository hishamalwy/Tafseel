# ============================================================
# Tafseel - .gitignore
# ============================================================


# ------------------------------------------------------------
# .NET build output
# ------------------------------------------------------------
**/bin/
**/obj/
artifacts/
publish/
[Pp]ublishProfiles/

*.nupkg
*.snupkg
*.coverage
*.coverage.*
*.trx

TestResults/
coverage/


# ------------------------------------------------------------
# Visual Studio / IDEs / Editors
# ------------------------------------------------------------
.vs/
.idea/
.vscode/

*.user
*.suo
*.swp
*.tmp
*.DotSettings.user


# ------------------------------------------------------------
# Node / Angular
# ------------------------------------------------------------
node_modules/

frontend-angular/dist/
frontend-angular/.angular/
frontend-angular/out-tsc/

# Generated by npm run sync:design.
# Source files live in css/ and assets/.
frontend-angular/src/generated/
frontend-angular/public/assets/


# ------------------------------------------------------------
# Python / miscellaneous language caches
# ------------------------------------------------------------
__pycache__/
*.py[cod]

.pytest_cache/
.mypy_cache/
.ruff_cache/


# ------------------------------------------------------------
# Local AI / developer tooling
# ------------------------------------------------------------
.claude/
.codex/
.codex-run/
.cursor/
.impeccable/
.hallmark/
.godaudits/

# Local-only tools directory
/tools/

# Local design sandbox
design-lab/


# ------------------------------------------------------------
# Secrets / local configuration
# ------------------------------------------------------------
.env
.env.*
!.env.example

appsettings.*.Local.json
**/appsettings.*.Host.json

*.pubxml.user
*.publishSettings

# Private / signing keys
*.pem
*.key
*.pfx
*.p12

# Local IIS deployment configuration
deploy/iis-runasp/web.config

# Browser authentication state
tests/browser/.auth/


# ------------------------------------------------------------
# Runtime application data
# ------------------------------------------------------------
uploads/
**/App_Data/*

# Preserve expected logs directory placeholder
!src/Tafseel.Api/App_Data/logs/
src/Tafseel.Api/App_Data/logs/*
!src/Tafseel.Api/App_Data/logs/.keep


# ------------------------------------------------------------
# Logs / temporary files
# ------------------------------------------------------------
*.log

.tmp*/
tmp/
tmp-*
tmp-*.mjs


# ------------------------------------------------------------
# Playwright / browser automation
# ------------------------------------------------------------
playwright-report/
blob-report/
test-results/
**/playwright/.cache/

browser-output/

**/out/screenshots/
**/screenshots/
**/evidence/
**/journeys*/

traces/
*.trace.zip
*.har
*.png.diff


# ------------------------------------------------------------
# Generated audit / review output
# ------------------------------------------------------------
audit-output/

docs/audits/
docs/reports/
docs/prompts/

_audit_*
_css_diff.json
_html_usage.json

/audit_extract.ps1
/i18n_usage.csv
/locales_en_keys.txt
/missing_i18n_keys.txt
/landing-fold-check.png
/self-test-results.json

/scripts/tmp-*.mjs
tests/browser/_*.mjs
tests/browser/tmp-*.mjs


# ------------------------------------------------------------
# Raw design / branding source material
#
# Runtime assets that are actually used by Tafseel should live
# in assets/ or the appropriate frontend source folder.
# ------------------------------------------------------------
/Tafseel Brand/

*.ai
*.psd


# ------------------------------------------------------------
# OS generated files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
Desktop.ini
.thumbnail


# ------------------------------------------------------------
# Stray malformed build output
# ------------------------------------------------------------
**/Users*AppData*/